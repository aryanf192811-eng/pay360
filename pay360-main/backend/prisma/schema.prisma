generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendances {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id          String    @db.Uuid
  check_in             DateTime  @db.Timestamptz(6)
  check_out            DateTime? @db.Timestamptz(6)
  worked_hours         Decimal?  @default(dbgenerated("\nCASE\n    WHEN (check_out IS NULL) THEN NULL::numeric\n    ELSE round((EXTRACT(epoch FROM (check_out - check_in)) / 3600.0), 2)\nEND")) @db.Decimal(6, 2)
  status               String    @default("present")
  is_manual_correction Boolean   @default(false)
  corrected_by         String?   @db.Uuid
  notes                String?
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @db.Timestamptz(6)
  users                users?    @relation(fields: [corrected_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees            employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id, check_in])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model audit_logs {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  table_name     String
  record_id      String   @db.Uuid
  user_id        String?  @db.Uuid
  action         String
  changed_fields Json
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  users          users?   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([table_name, record_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This table contains exclusion constraints and requires additional setup for migrations. Visit https://pris.ly/d/exclusion-constraints for more info.
model contracts {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id         String                    @db.Uuid
  department_id       String?                   @db.Uuid
  position            String?
  wage                Decimal                   @db.Decimal(12, 2)
  salary_structure_id String?                   @db.Uuid
  date_start          DateTime                  @db.Date
  date_end            DateTime?                 @db.Date
  status              String                    @default("draft")
  created_at          DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime                  @default(now()) @db.Timestamptz(6)
  date_range          Unsupported("daterange")? @default(dbgenerated("daterange(date_start, COALESCE(date_end, 'infinity'::date), '[]'::text)"))
  departments         departments?              @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees           employees                 @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  salary_structures   salary_structures?        @relation(fields: [salary_structure_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payslips            payslips[]

  @@index([employee_id])
}

model departments {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String      @unique
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  contracts  contracts[]
  employees  employees[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model employees {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_code        String                 @unique
  first_name           String
  last_name            String
  email                String                 @unique @db.Citext
  phone                String?
  department_id        String?                @db.Uuid
  manager_id           String?                @db.Uuid
  job_position         String?
  schedule_id          String?                @db.Uuid
  employee_type        String
  status               String                 @default("active")
  hire_date            DateTime               @db.Date
  bank_account_number  String?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  attendances          attendances[]
  contracts            contracts[]
  departments          departments?           @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees            employees?             @relation("employeesToemployees", fields: [manager_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_employees      employees[]            @relation("employeesToemployees")
  working_schedules    working_schedules?     @relation(fields: [schedule_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payrun_employees     payrun_employees[]
  payslips             payslips[]
  time_off_allocations time_off_allocations[]
  time_off_requests    time_off_requests[]
  users                users?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payroll_warnings {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payslip_id   String?   @db.Uuid
  payrun_id    String?   @db.Uuid
  warning_type String
  message      String
  resolved     Boolean   @default(false)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  payruns      payruns?  @relation(fields: [payrun_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payslips     payslips? @relation(fields: [payslip_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model payrun_employees {
  payrun_id   String    @db.Uuid
  employee_id String    @db.Uuid
  employees   employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payruns     payruns   @relation(fields: [payrun_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([payrun_id, employee_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payruns {
