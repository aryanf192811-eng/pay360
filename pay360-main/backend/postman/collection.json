      "item": [
        {
          "name": "Register (Employee)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{testEmail}}\",\"password\":\"SecurePass1!\",\"role\":\"employee\"}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('testEmail', 'test_' + Date.now() + '_' + Math.floor(Math.random() * 100000) + '@postman.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is correct', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response shape is correct', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success', true);\n    if (true) pm.expect(jsonData).to.have.property('data');\n    else pm.expect(jsonData).to.have.property('error');",
                  "});"
                ]
              }
            }
          ]
