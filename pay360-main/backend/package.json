{
  "name": "peoplepay360-backend",
  "version": "1.0.0",
  "description": "PeoplePay360 HR & Payroll — backend API (Express + pg, no ORM)",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate:up": "node-pg-migrate up --migrations-dir src/db/migrations --database-url-var DATABASE_URL",
    "migrate:down": "node-pg-migrate down --migrations-dir src/db/migrations --database-url-var DATABASE_URL",
    "seed": "node src/db/seed.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mathjs": "^13.0.0",
    "node-pg-migrate": "^7.3.2",
    "nodemailer": "^10.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
