{
  "mcpServers": {
    "postgres": {
      "command": "npx",
      "args": ["-y", "@henkey/postgres-mcp-server@1.0.7", "--connection-string", "${DATABASE_URL}"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2026.8.31", "."]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.80"]
    }
  }
}
